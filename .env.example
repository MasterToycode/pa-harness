# pah 的本地凭据文件（复制成 .env 后填写；.env 已被 .gitignore 忽略，不会进仓库）
#
# 用法：copy .env.example .env  然后把等号右边的值填上。
# pah 每次启动会读当前目录的 .env；已经存在的环境变量优先（shell 里临时覆盖仍然有效）。
# 也可以用 $PAH_ENV_FILE 指向别的文件。

# —— 决策层（LLM）——
# 从 platform.deepseek.com 拿
DEEPSEEK_API_KEY=
# 百炼/千问（base_url 用 compatible-mode）：https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
# 火山方舟
VOLCENGINE_CODING_API_KEY=
# 中转站（OpenAI 兼容）
APIMART_API_KEY=
OPENROUTER_API_KEY=

# —— 生成层（3D 生成服务）——
# 混元生3D 用的是腾讯云 SecretId + SecretKey（不是 sk- 那种 key）：
#   腾讯云控制台 → 访问管理 CAM → API 密钥管理 → 新建密钥
#   并在 https://console.cloud.tencent.com/ai3d 开通「混元生3D」（按任务计费）
# 填完跑：python examples\hunyuan3d_materializer.py --check
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=ap-guangzhou
# 档位：standard（默认）/ rapid（极速）/ pro（最高精度、PBR、多视角）
HUNYUAN3D_TIER=standard
# 模型版本：不填 = 服务默认；要锁 2.5 就写 HY-3D-2.5（具体取值以开通后接口为准）
HUNYUAN3D_MODEL=

# 其它 3D 服务（如果你换一家）
# TRIPO_API_KEY=

# —— 外部工具 ——
# Blender：混元的「组件生成」接口（SubmitHunyuan3DPartJob，P3-SAM + X-Part）
# **只接受 FBX**，而 STL/GLB 转 FBX 没有纯 Python 方案，只能靠 Blender 无头调用。
# 下载便携版（免安装，解压即用）：
#   https://mirrors.tuna.tsinghua.edu.cn/blender/release/Blender4.5/
#   选 blender-4.5.x-windows-x64.zip
# 然后把这个变量指向解压后的 blender.exe：
PAH_BLENDER=
# 例：PAH_BLENDER=D:\tools\blender-4.5.15-windows-x64\blender.exe
# 自检：python -m pah.tools.fbx
